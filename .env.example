# OpenRouter AI Configuration
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use — customizable without code modifications
# Options:
#   Free:   nvidia/nemotron-3-super-120b-a12b:free, nvidia/nemotron-3.5-lightning:free
#   Paid:   anthropic/claude-3.5-haiku, openai/gpt-4o-mini
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional site name for OpenRouter rankings/dashboard
OPENROUTER_SITE_NAME=AI Trading Research Assistant

# Optional frontend API URL override (defaults to http://127.0.0.1:8000/api)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
